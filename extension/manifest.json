{
  "manifest_version": 3,
  "name": "AutoConnexion",
  "version": "1.0.0",
  "description": "Se connecte automatiquement à tes sites : rejoue les clics enregistrés pendant que Bitwarden remplit les identifiants.",
  "permissions": ["storage", "activeTab", "favicon"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AutoConnexion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
